# Copy to .env and fill in values from your Twilio Console.
APP_ENV=development
DATABASE_PATH=./studychat.db
PUBLIC_BASE_URL=https://your-public-tunnel.example
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+your-twilio-sender
